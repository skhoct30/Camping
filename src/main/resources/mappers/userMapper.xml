<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

 
 
 <mapper namespace="com.skhoct30.camping.user.repository.UserRepository">
 
 	<insert id="insertUser" parameterType="map">
 		
 		INSERT INTO
 			`user`
 		(
 			`loginId`
 			, `password`
 			, `name`
 			, `phoneNumber`
 		)
 		VALUE
 		(
 			#{loginId}
 			, #{password}
 			, #{name}
 			, #{phoneNumber}
 		)
 	
 	</insert>
 	
 	
 	<select id="selectCountByLoginId" parameterType="string"
 	resultType="int">
 	
 		SELECT
 			count(*)
 		FROM
 			`user`
 		WHERE
 			LOWER(`loginId`) = LOWER(#{loginId})
 	
 	</select>
 	
 	<!-- 로그인을 위한 xml -->
 	<select id="selectUser" parameterType="map" resultType="com.skhoct30.camping.user.domain.User">
 	
 		SELECT
 			`id`
 			, `loginId`
 			, `password`
 			, `name`
 			, `phoneNumber`
 		FROM
 			`user`
 		WHERE
 			`loginId` = #{loginId}
 			AND `password` = #{password}
 	
 	</select>
 
 
 
 </mapper>